<script>
/* =========================================================
   CONST
========================================================= */
const DAYS = ["Понедельник","Вторник","Среда","Четверг","Пятница","Суббота","Воскресенье"];
const DAYS_SHORT = ["Пн","Вт","Ср","Чт","Пт","Сб","Вс"];
const MAX_STUDENTS = 3;

const STATUS_MAP = {
    "н":  { cls:"g", label:"Присутствовал" },
    "нб": { cls:"g", label:"Присутствовал" },
    "+":  { cls:"a", label:"Опоздал" },
    "оп": { cls:"a", label:"Опоздал" },
    "б":  { cls:"b", label:"Болел" },
    "болезнь": { cls:"b", label:"Болел" },
    "у":  { cls:"u", label:"Уважительная" },
    "ув": { cls:"u", label:"Уважительная" },
    "п":  { cls:"r", label:"Пропустил" },
    "нп": { cls:"r", label:"Пропустил" },
    "пр": { cls:"r", label:"Пропустил" }
};

/* =========================================================
   STATE
========================================================= */
let db = null;
let auth = null;
let currentUser = null;
let currentProfile = null;
let students = [];      // до 3
let attendanceCache = {}; // studentId → { days: {...}, recordsByDate: {...} }
let groupSettingsCache = {};

/* =========================================================
   HELPERS
========================================================= */
const $ = id => document.getElementById(id);

function esc(v){
    return String(v ?? "").replace(/[&<>"']/g, c => ({
        "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
    }[c]));
}

function getInitials(fio){
    const p = String(fio || "").trim().split(/\s+/).filter(Boolean);
    if (p.length >= 2) return (p[0][0] + p[1][0]).toUpperCase();
    if (p.length === 1) return p[0][0].toUpperCase();
    return "?";
}

function avatarGradient(name){
    const palette = [
        ["#3b82f6","#2563eb"],["#8b5cf6","#7c3aed"],
        ["#ec4899","#db2777"],["#f59e0b","#d97706"],
        ["#10b981","#059669"],["#06b6d4","#0891b2"],
        ["#ef4444","#dc2626"],["#6366f1","#4f46e5"]
    ];
    let h = 0;
    const s = String(name || "?");
    for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
    const [a,b] = palette[h % palette.length];
    return `background:linear-gradient(135deg,${a},${b})`;
}

function getStudentName(s){
    return s?.fullName || s?.name || s?.fio || "Без имени";
}

function normalizeStatus(v){
    if (v === null || v === undefined) return "";
    return String(v).trim().toLowerCase();
}

function statusInfo(v){
    const key = normalizeStatus(v);
    if (!key) return null;
    return STATUS_MAP[key] || { cls:"g", label: v };
}

function todayStr(){
    return new Date().toLocaleDateString("ru-RU",{day:"2-digit",month:"long",year:"numeric"});
}

function toast(text, type = "success"){
    const wrap = $("toasts");
    const el = document.createElement("div");
    el.className = "toast " + type;
    el.textContent = text;
    wrap.appendChild(el);
    requestAnimationFrame(() => el.classList.add("show"));
    setTimeout(() => {
        el.classList.remove("show");
        setTimeout(() => el.remove(), 300);
    }, 2600);
}

/* =========================================================
   THEME
========================================================= */
function applyTheme(mode){
    let effective = mode;
    if (mode === "auto"){
        effective = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    document.documentElement.setAttribute("data-theme", effective);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", effective === "dark" ? "#0b1220" : "#2563eb");
}
function toggleTheme(){
    const cur = localStorage.getItem("ph.theme") || "auto";
    const next = cur === "dark" ? "light" : cur === "light" ? "auto" : "dark";
    localStorage.setItem("ph.theme", next);
    applyTheme(next);
    toast(next === "light" ? "Светлая тема" : next === "dark" ? "Тёмная тема" : "Авто", "info");
}
(function initTheme(){
    const saved = localStorage.getItem("ph.theme") || "auto";
    applyTheme(saved);
})();

/* =========================================================
   USER MENU
========================================================= */
function toggleUserMenu(){
