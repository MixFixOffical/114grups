    firebase.auth().signOut().then(() => {
        window.location.href = "login.html";
    });
}
function refreshData(){
    loadAll(true);
    toast("Обновляем данные…", "info");
}

/* =========================================================
   LOAD DATA
========================================================= */
async function loadAll(isRefresh = false){
    try {
        if (!currentUser) return;

        // 1. находим связи родителя
        const linksSnap = await db.collection("links")
            .where("parentId", "==", currentUser.uid)
            .get();

        const studentIds = linksSnap.docs
            .map(d => d.data().studentId)
            .filter(Boolean)
            .slice(0, MAX_STUDENTS);

        if (!studentIds.length){
            renderEmptyState();
            $("loadingScreen").classList.add("hide");
            return;
        }

        // 2. тянем студентов
        const studentDocs = await Promise.all(
            studentIds.map(id => db.collection("students").doc(id).get())
        );
        students = studentDocs
            .filter(d => d.exists)
            .map(d => ({ id: d.id, ...d.data() }));

        // 3. тянем настройки групп (расписание + дисциплины)
        const groupIds = [...new Set(students.map(s => s.groupId).filter(Boolean))];
        await Promise.all(groupIds.map(async gid => {
            try {
                const g = await db.collection("groupSettings").doc(gid).get();
                groupSettingsCache[gid] = g.exists ? g.data() : null;
            } catch { groupSettingsCache[gid] = null; }
        }));

        // 4. тянем посещаемость по каждому студенту
        await Promise.all(students.map(s => loadStudentAttendance(s)));

        renderAll();

        if (isRefresh) toast("Данные обновлены", "success");
    } catch (e){
        console.error(e);
        toast("Ошибка загрузки: " + (e.message || e), "error");
    } finally {
        $("loadingScreen").classList.add("hide");
    }
}

/* =========================================================
   ATTENDANCE LOADER
   Пробуем разные варианты структуры
========================================================= */
async function loadStudentAttendance(student){
    const cache = { days:{}, recordsByDate:{} };

    try {
        // Вариант А: attendance/{studentId} — документ с полем records
        const docRef = db.collection("attendance").doc(student.id);
        const doc = await docRef.get();
        if (doc.exists){
            const data = doc.data() || {};
            if (data.records && typeof data.records === "object"){
                cache.recordsByDate = data.records;
            }
            if (data.days && typeof data.days === "object"){
                cache.days = data.days;
            }
        }

        // Вариант Б: attendance/{studentId}/days/{date} — на каждый день
        if (!Object.keys(cache.recordsByDate).length){
            try {
                const daysSnap = await db
                    .collection("attendance")
                    .doc(student.id)
                    .collection("days")
                    .get();
                daysSnap.forEach(d => {
                    cache.recordsByDate[d.id] = d.data();
                });
            } catch {}
        }

        // Вариант В: attendance — плоская коллекция { studentId, date, ... }
        if (!Object.keys(cache.recordsByDate).length){
            try {
                const flat = await db.collection("attendance")
                    .where("studentId", "==", student.id)
                    .get();
                flat.forEach(d => {
                    const data = d.data() || {};
                    const date = data.date || d.id;
                    if (date) cache.recordsByDate[date] = data.marks || data.records || data;
                });
            } catch {}
        }
    } catch (e){
        console.warn("attendance load error for", student.id, e);
    }

    attendanceCache[student.id] = cache;
}

/* =========================================================
   RENDER
========================================================= */
function renderAll(){
    renderWelcome();
    renderStudents();
}

function renderWelcome(){
    const name = (currentProfile?.name || currentProfile?.fullName || "").trim();
    const firstName = name.split(/\s+/)[0] || "родитель";
    $("welcomeName").textContent = firstName;
    $("userName").textContent = name || "Родитель";
    $("userAvatar").textContent = getInitials(name || "?");
    $("metaDate").textContent = todayStr();
    $("metaCount").textContent = students.length;

    // считаем общий процент посещаемости
    let total = 0, present = 0;
    students.forEach(s => {
        const stats = computeStudentStats(s);
        total += stats.total;
        present += stats.present;
    });
    const rate = total ? Math.round(present / total * 100) : 0;
    $("metaRate").textContent = total ? rate + "%" : "—";

    $("sectionSub").textContent = students.length
        ? `Показаны данные по ${students.length} ${plural(students.length,"студенту","студентам","студентам")}`
        : "Загрузка данных…";
}

function plural(n, one, few, many){
    const x = n % 100;
    if (x >= 11 && x <= 19) return many;
    switch(n % 10){
        case 1: return one;
        case 2: case 3: case 4: return few;
        default: return many;
    }
}

function renderEmptyState(){
    const container = $("studentsContainer");
    container.innerHTML = `
        <div class="empty-state">
            <div class="empty-state-icon">🔗</div>
            <h3>Пока нет привязанных студентов</h3>
            <p>
                Обратитесь к администратору, чтобы он привязал вашего ребёнка
                к вашему аккаунту. После этого здесь появится посещаемость.
            </p>
        </div>`;
    $("metaCount").textContent = "0";
    $("metaRate").textContent = "—";
    $("sectionSub").textContent = "Студенты не найдены";
}

function renderStudents(){
    const container = $("studentsContainer");

    if (!students.length){
        renderEmptyState();
        return;
    }

    container.innerHTML = students.map((s, i) => renderStudentCard(s, i)).join("");
}

function renderStudentCard(student, index){
    const name = getStudentName(student);
    const group = student.group || student.groupName || student.groupId || "—";
    const stats = computeStudentStats(student);
    const schedule = getSchedule(student);
    const disciplines = getDisciplines(student);
    const records = attendanceCache[student.id]?.recordsByDate || {};

    // Собираем матрицу: строки = дни недели, столбцы = номера пар
    const matrix = buildAttendanceMatrix(records, schedule);

    const attHtml = renderAttendanceTable(matrix, schedule, disciplines, stats);

    return `
        <div class="student-card">
            <div class="student-head">
                <div class="student-avatar" style="${avatarGradient(name)}">
                    ${esc(getInitials(name))}
                </div>
                <div class="student-info">
                    <div class="student-name">${esc(name)}</div>
                    <div class="student-meta">
                        ${group && group !== "—" ? `<span class="meta-badge">📚 Группа ${esc(group)}</span>` : ""}
                        <span>Всего пар: <b>${stats.total}</b></span>
                    </div>
                </div>
                <div class="student-stats">
                    <span class="mini-stat good">✅ ${stats.present}</span>
                    ${stats.late ? `<span class="mini-stat warn">⏰ ${stats.late}</span>` : ""}
                    ${stats.sick ? `<span class="mini-stat" style="background:var(--cyan-light);color:var(--cyan-text)">🤒 ${stats.sick}</span>` : ""}
                    ${stats.absent ? `<span class="mini-stat bad">❌ ${stats.absent}</span>` : ""}
                </div>
            </div>
            <div class="att-wrap">
                ${attHtml}
            </div>
        </div>`;
}

/* =========================================================
   COMPUTE STATS
========================================================= */
function computeStudentStats(student){
    const records = attendanceCache[student.id]?.recordsByDate || {};
    let total = 0, present = 0, late = 0, sick = 0, excused = 0, absent = 0;

    Object.values(records).forEach(dayObj => {
        if (!dayObj || typeof dayObj !== "object") return;
        Object.values(dayObj).forEach(v => {
            const info = statusInfo(v);
            if (!info) return;
            total++;
            if (info.cls === "g") present++;
            else if (info.cls === "a") late++;
            else if (info.cls === "b") sick++;
            else if (info.cls === "u") excused++;
            else if (info.cls === "r") absent++;
        });
    });

    return { total, present, late, sick, excused, absent };
}

/* =========================================================
   SCHEDULE / DISCIPLINES из groupSettings
========================================================= */
function getSchedule(student){
    const settings = groupSettingsCache[student.groupId];
    const schedule = settings?.schedule || {};
    const result = {};
    DAYS.forEach(d => {
        const n = Number(schedule[d] || 0);
        result[d] = Math.max(0, Math.min(7, n));
    });
    return result;
}

function getDisciplines(student){
    const settings = groupSettingsCache[student.groupId];
    return settings?.disciplines || {};
}

/* =========================================================
   MATRIX: [день] → [номер пары] → { date, status }
   Ищем последнюю запись по каждому дню недели за последние 3 недели
========================================================= */
function buildAttendanceMatrix(recordsByDate, schedule){
    const matrix = {};
    DAYS.forEach(d => { matrix[d] = {}; });

    const dates = Object.keys(recordsByDate).sort().reverse();

    // Для каждой даты определяем день недели и раскладываем
    // Берём последнюю (свежую) запись для каждого дня недели
    for (const date of dates){
        const dow = getDayOfWeek(date);
        if (!dow) continue;
        const dayMarks = recordsByDate[date];
        if (!dayMarks || typeof dayMarks !== "object") continue;

        const maxLesson = Math.max(schedule[dow] || 0, ...Object.keys(dayMarks).map(n => Number(n) || 0));
        for (let i = 1; i <= maxLesson; i++){
            const v = dayMarks[i] ?? dayMarks[String(i)];
            if (v === undefined || v === null) continue;
            if (matrix[dow][i] === undefined){
                matrix[dow][i] = { date, status: v };
            }
        }
    }

    return matrix;
}

function getDayOfWeek(dateStr){
    // Ожидаем YYYY-MM-DD или совместимый ISO
    const m = String(dateStr).match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (!m) return null;
    const d = new Date(Number(m[1]), Number(m[2])-1, Number(m[3]));
    const jsDay = d.getDay(); // 0=Вс, 1=Пн...
    if (jsDay === 0) return "Воскресенье";
    return DAYS[jsDay - 1];
}

/* =========================================================
   RENDER TABLE
========================================================= */
function renderAttendanceTable(matrix, schedule, disciplines, stats){
    const activeDays = DAYS.filter(d => schedule[d] > 0);

    if (!activeDays.length){
        return `
            <div class="att-empty">
                <div class="att-empty-icon">🗓️</div>
                <div class="att-empty-title">Расписание не настроено</div>
                <div>Обратитесь к куратору или администратору.</div>
            </div>`;
    }

    const hasAnyMarks = Object.values(matrix).some(day => Object.keys(day).length > 0);

    if (!hasAnyMarks){
        return `
            <div class="att-empty">
                <div class="att-empty-icon">📭</div>
                <div class="att-empty-title">Посещаемость пока не отмечена</div>
                <div>Данные появятся после того, как куратор начнёт отмечать пары.</div>
            </div>`;
    }

    // Заголовки: [День] [1] [2] ... [N]
    const maxLessons = Math.max(...activeDays.map(d => schedule[d]));

    let html = `
        <div class="att-hint">
            <span>📅 Последние отметки по дням недели</span>
            <div class="att-legend">
                <span class="legend-item"><span class="legend-dot g">н</span> присут.</span>
                <span class="legend-item"><span class="legend-dot a">+</span> опоздал</span>
                <span class="legend-item"><span class="legend-dot b">б</span> болел</span>
                <span class="legend-item"><span class="legend-dot u">у</span> уваж.</span>
                <span class="legend-item"><span class="legend-dot r">п</span> пропуск</span>
            </div>
        </div>
        <table class="att-table">
            <thead>
                <tr>
                    <th>День недели</th>`;

    for (let i = 1; i <= maxLessons; i++){
        const sampleDiscipline = getDisciplineForLesson(activeDays, disciplines, i);
        html += `<th>
            <span class="lesson-num">${i} пара</span>
            ${sampleDiscipline ? `<span class="lesson-name">${esc(sampleDiscipline)}</span>` : ""}
        </th>`;
    }

    html += `</tr></thead><tbody>`;

    activeDays.forEach(day => {
        const dayScheduleCount = schedule[day];
        html += `<tr><td>${esc(day)}</td>`;
        for (let i = 1; i <= maxLessons; i++){
            if (i > dayScheduleCount){
                html += `<td><span class="cell empty">·</span></td>`;
                continue;
            }
            const cell = matrix[day]?.[i];
            if (!cell || !cell.status){
                html += `<td><span class="cell empty">—</span></td>`;
                continue;
            }
            const info = statusInfo(cell.status);
            const mark = (cell.status + "").trim().slice(0, 2) || "?";
            html += `<td title="${esc(info.label)} · ${esc(cell.date)}">
                <span class="cell ${info.cls}">${esc(mark)}</span>
            </td>`;
        }
        html += `</tr>`;
    });

    html += `</tbody></table>`;
    return html;
}

function getDisciplineForLesson(activeDays, disciplines, lessonNum){
    // Берём первую попавшуюся дисциплину для этой пары (обычно одинаковая)
    for (const day of activeDays){
        const arr = disciplines[day];
        if (Array.isArray(arr) && arr[lessonNum - 1]){
            return arr[lessonNum - 1];
        }
    }
    return "";
}

